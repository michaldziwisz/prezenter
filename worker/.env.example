NODE_ENV=production
PORT=8080
HOST=0.0.0.0
DATA_DIR=/data

# Comma-separated origins allowed to call the API from a browser.
ALLOWED_ORIGINS=https://example.github.io,http://localhost:8080,http://localhost:5173

# Public URLs used when the worker returns presenter/viewer links.
PUBLIC_API_URL=https://api.example.org
PUBLIC_FRONTEND_URL=https://example.github.io/prezenter

# dry-run accepts and records publications without external calls.
# live uploads to archive.org and dispatches the GitHub Actions workflow.
PUBLISH_MODE=dry-run

MAX_UPLOAD_BYTES=104857600
MAX_PUBLICATIONS_PER_HOUR=20

# Internet Archive credentials. Never expose these to the frontend.
ARCHIVE_ACCESS_KEY=
ARCHIVE_SECRET_KEY=
ARCHIVE_SOURCE_PREFIX=prezenter-source
ARCHIVE_OUTPUT_PREFIX=prezenter
ARCHIVE_COLLECTION=
ARCHIVE_CREATOR=Prezenter

# GitHub Actions dispatch target.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_WORKFLOW=build-presentation.yml
GITHUB_REF=main

# Shared secret for GitHub Actions -> worker callback.
CALLBACK_SECRET=

